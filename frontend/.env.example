# ============================================================
# MAP & WEATHER PROVIDER API KEYS
# ============================================================
# Prefix all keys with VITE_ so Vite exposes them safely to client JS via import.meta.env
#
# 1. Standard Map Key (Mapbox, Stadia Maps, MapTiler, LocationIQ, etc.)
VITE_MAP_API_KEY=

# 2. Mapbox Token (Optional: https://account.mapbox.com/)
VITE_MAPBOX_TOKEN=

# 3. OpenWeatherMap Key (Optional: https://openweathermap.org/api)
VITE_OPENWEATHER_API_KEY=

# 4. Backend API Base URL (Set in Vercel Dashboard for production)
# Example: https://flash-flood-backend.onrender.com
VITE_API_BASE_URL=

