# ==============================================================================
# Flash Flood & Multi-Disaster Prediction Platform — Environment Configuration
# ==============================================================================
# Copy this file to .env for local deployment.
# DO NOT COMMIT REAL PRODUCTION KEYS TO SOURCE CONTROL.

# ------------------------------------------------------------------------------
# Server & Network Configuration
# ------------------------------------------------------------------------------
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development  # development | staging | production
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# Authentication & Gateway Security Keys
# ------------------------------------------------------------------------------
ADMIN_AUTH_KEY=AUTH-ADMIN-KEY-99
RESPONDER_AUTH_KEY=RESPONDER-AUTH-KEY-2026
SIREN_AUTH_KEY=AUTH-ADMIN-KEY-99

# ------------------------------------------------------------------------------
# External API Providers (Leave empty for DEMO fallback mode)
# ------------------------------------------------------------------------------
OPEN_METEO_API_URL=https://api.open-meteo.com/v1
USGS_EARTHQUAKE_API_URL=https://earthquake.usgs.gov/fdsnws/event/1

# SMS Provider Credentials (Twilio / Local Gateway)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Push Notification Credentials (FCM / APNs / Web Push)
FCM_SERVER_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
